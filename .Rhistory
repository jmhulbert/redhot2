library(ggmap)
library(osmdata)
seattle.combined <- read.csv('https://github.com/jmhulbert/redhot2/raw/refs/heads/main/data/Seattle.Trees.Heat.csv')
seattle.combined <- read.csv('https://github.com/jmhulbert/redhot2/raw/refs/heads/main/data/Seattle.Trees.Heat.csv')
names(seattle.combined)
seattle.redcedar <- seattle.combined %>% filter(SCIENTIFIC=="Thuja plicata")
seattle.combined <- read.csv('https://github.com/jmhulbert/redhot2/raw/refs/heads/main/data/Seattle.Trees.Heat.csv')
names(seattle.combined)
seattle.redcedar <- seattle.combined %>% filter(SCIENTIFIC=="Thuja plicata")
seattle.combined <- seattle.combined %>% filter(kc_af1>0)  %>% mutate(kc.am.f=kc_am1, kc.af.f=kc_af1,kc.pm.f=kc_pm1) %>% mutate(kc.am.c=(((kc.am.f-32)*5)/9),kc.af.c=(((kc.af.f-32)*5)/9),kc.pm.c=(((kc.pm.f-32)*5)/9)) %>% mutate(mean.temp.daily.f=((kc.am.f+kc.af.f+kc.pm.f)/3)) %>% mutate(dist.from.mean.daily.f=mean.temp.daily.f-(mean(mean.temp.daily.f,na.rm=TRUE))) %>% mutate(mean.temp.daily.c=((kc.am.c+kc.af.c+kc.pm.c)/3)) %>% mutate(dist.from.mean.daily.c=mean.temp.daily.c-(mean(mean.temp.daily.c,na.rm=TRUE))) %>% mutate(Area="King County")
seattle.combined <- seattle.combined %>% mutate(dist.from.mean.am.c = kc.am.c-(mean(kc.am.c,na.rm=TRUE)),dist.from.mean.am.f=kc.am.f-(mean(kc.am.f,na.rm=TRUE))) %>% mutate(dist.from.mean.af.c = kc.af.c-(mean(kc.af.c,na.rm=TRUE)),dist.from.mean.af.f=kc.af.f-(mean(kc.af.f,na.rm=TRUE))) %>% mutate(dist.from.mean.pm.c = kc.pm.c-(mean(kc.pm.c,na.rm=TRUE)),dist.from.mean.pm.f=kc.pm.f-(mean(kc.pm.f,na.rm=TRUE)))
seattle.redcedar <- seattle.combined %>% filter(SCIENTIFIC=="Thuja plicata")
seattle.streets <- seattle.combined %>% filter(Source.Department=="Seattle Department of Transportation") %>% mutate(city.space="Street")
names(seattle.combined)
seattle.streets <- seattle.combined %>% filter(SOURCE_DEP=="Seattle Department of Transportation") %>% mutate(city.space="Street")
seattle.parks <- seattle.combined %>% filter(SOURCE_DEP=="Seattle Parks and Recreation") %>% mutate(city.space="Park")
seattle.combined.back <- rbind(seattle.streets,seattle.parks)
names(seattle.combined)
names(seattle.combined.back)
seattle.most <- seattle.combined.back %>% filter(kc.af.f>90.29)%>% mutate(Category25="Most Concern") %>% droplevels()
seattle.mod <- seattle.combined.back %>% filter(kc.af.f>85.74 & kc.af.f<90.29) %>% mutate(Category25="Moderate Concern") %>% droplevels()
seattle.low <- seattle.combined.back %>% filter(kc.af.f<85.74) %>% mutate(Category25="Lowest Concern") %>% droplevels()
seattle.combined.cat <- bind_rows(list(seattle.low,seattle.mod,seattle.most))
ggplot(seattle.combined.cat,aes(n,Category25,fill=Category25))+geom_col(alpha=0.7) +facet_wrap(~city) +theme_bw() + scale_fill_manual(name="Category",values=c("#7fcdbb","#fe9929","#DDA0DD")) +labs(x="Number of Trees",y="Concern Category") +guides(fill="none")
ggplot(seattle.combined.cat,aes(n,Category25,fill=Category25))+geom_col(alpha=0.7) +theme_bw() + scale_fill_manual(name="Category",values=c("#7fcdbb","#fe9929","#DDA0DD")) +labs(x="Number of Trees",y="Concern Category") +guides(fill="none")
ggplot(seattle.combined.cat,aes(Category25,fill=Category25))+geom_histogram(alpha=0.7) +theme_bw() + scale_fill_manual(name="Category",values=c("#7fcdbb","#fe9929","#DDA0DD")) +labs(x="Number of Trees",y="Concern Category") +guides(fill="none")
ggplot(seattle.combined.cat,aes(Category25,fill=Category25))+geom_bar(alpha=0.7) +theme_bw() + scale_fill_manual(name="Category",values=c("#7fcdbb","#fe9929","#DDA0DD")) +labs(x="Number of Trees",y="Concern Category") +guides(fill="none")
