library(tidyverse)
library(knitr)
library(kableExtra)
library(gghalves)
library(patchwork)
library(scales)
library(ggmap)
library(osmdata)
data <- read.csv('https://raw.githubusercontent.com/jmhulbert/redhot2/refs/heads/main/data/urban-data-modified.csv')
portland <- data %>% filter(Area=="Portland")
king <- data %>% filter(Area=="King County")
tacoma <-data %>% filter(Area=="Tacoma")
portbb <- c(left = min(portland$longitude.x),
bottom = min(portland$latitude.x),
right = max(portland$longitude.x),
top = max(portland$latitude.x))
#ggmap::register_google(key="")
portmap <- get_map(portbb, zoom = 11, scale = 2, maptype="terrain",source="google")
tacomamap <- get_map(tacomabb, zoom = 11, scale = 2,maptype="terrain",source="google")
tacomamap <- get_map(tacomabb, zoom = 11, scale = 2,maptype="terrain",source="google")
