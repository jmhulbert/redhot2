sum.table <- seattle.wrc.cat %>% group_by(Category25) %>% summarize (n=n())
sum.table
seabb <- c(left = min(seattle.wrc.cat$longitude),
bottom = min(seattle.wrc.cat$latitude),
right = max(seattle.wrc.cat$longitude),
top = max(seattle.wrc.cat$latitude))
seamap <- get_map(seabb, zoom = 11, scale = 2, maptype="terrain",source="google")
seattle.map <- ggmap(seamap) + geom_point(data = seattle.combined.cat, aes(x = lon, y = lat,fill=DN_AF1), color = "black",pch=21, size = 3) + theme_minimal() +scale_fill_viridis_c(option = "inferno")+labs(title="Seattle",x="Longitude",y="Latitude",fill="Afternoon\nTemp (F)") +theme(plot.title = element_text(size = 14, hjust = .5,face = "bold.italic"))
seattle.map <- ggmap(seamap) + geom_point(data = seattle.wrc.cat, aes(x = lon, y = lat,fill=DN_AF1), color = "black",pch=21, size = 3) + theme_minimal() +scale_fill_viridis_c(option = "inferno")+labs(title="Seattle",x="Longitude",y="Latitude",fill="Afternoon\nTemp (F)") +theme(plot.title = element_text(size = 14, hjust = .5,face = "bold.italic"))
