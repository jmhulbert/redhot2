library(tidyverse)
library(knitr)
library(kableExtra)
library(gghalves)
library(patchwork)
library(scales)
library(ggmap)
library(osmdata)
data <- read.csv('https://raw.githubusercontent.com/jmhulbert/redhot2/refs/heads/main/data/urban-data-modified.csv')
portland <- data %>% filter(Area=="Portland")
king <- data %>% filter(Area=="King County")
tacoma <-data %>% filter(Area=="Tacoma")
portbb <- c(left = min(portland$longitude.x),
bottom = min(portland$latitude.x),
right = max(portland$longitude.x),
top = max(portland$latitude.x))
#ggmap::register_google(key="")
portmap <- get_map(portbb, zoom = 11, scale = 2, maptype="terrain",source="google")
portland.map.f <- ggmap(portmap) + geom_point(data = portland, aes(x = longitude.x, y = latitude.x,fill=pl.af.f), color = "black",pch=21, size = 3) + theme_minimal() +scale_fill_viridis_c(option = "inferno")+labs(title="Portland",x="Longitude",y="Latitude",fill="Afternoon\nTemp (F)") +theme(plot.title = element_text(size = 14, hjust = .5,face = "bold.italic"))
portland.map.f
portland.map.c <- ggmap(portmap) + geom_point(data = portland, aes(x = longitude.x, y = latitude.x,fill=pl.af.c), color = "black",pch=21, size = 3) + theme_minimal() +scale_fill_viridis_c(option = "inferno")+labs(title="Portland",x="Longitude",y="Latitude",fill="Afternoon\nTemp (C)") +theme(plot.title = element_text(size = 14, hjust = .5,face = "bold.italic"))
portland.map.c
kingbb <- c(left = min(king$longitude.x),
bottom = min(king$latitude.x),
right = max(king$longitude.x),
top = max(king$latitude.x))
kingmap <- get_map(kingbb, zoom = 10, scale = 2,maptype="terrain",source="google")
king.map.f <- ggmap(kingmap) + geom_point(data = king, aes(x = longitude.x, y = latitude.x,fill=kc.af.f), color = "black",pch=21, size = 3) + theme_minimal() +scale_fill_viridis_c(option = "inferno")+labs(title="King County",x="Longitude",y="Latitude",fill="Afternoon\nTemp (F)") +theme(plot.title = element_text(size = 14, hjust = .5,face = "bold.italic"))
king.map.f
king.map.c <- ggmap(kingmap) + geom_point(data = king, aes(x = longitude.x, y = latitude.x,fill=kc.af.c), color = "black",pch=21, size = 3) + theme_minimal() +scale_fill_viridis_c(option = "inferno")+labs(title="King County",x="Longitude",y="Latitude",fill="Afternoon\nTemp (C)") +theme(plot.title = element_text(size = 14, hjust = .5,face = "bold.italic"))
king.map.c
tacomabb <- c(left = -122.5,bottom = 47.2, right = -122.3, top = 47.3)
min(tacoma$latitude.x) #bottom
max(tacoma$latitude.x) #top
min(tacoma$longitude.x) #left
